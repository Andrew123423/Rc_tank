<?xml version="1.0"?>
<sdf version="1.9">
 <world name="tank_world">
  <physics name="physics" type="ignored"><max_step_size>@STEP@</max_step_size><real_time_factor>1</real_time_factor></physics>
  <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
  <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
  <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
  <scene><ambient>0.5 0.5 0.5 1</ambient><background>0.65 0.72 0.8 1</background><shadows>false</shadows></scene>
  <light name="sun" type="directional"><pose>0 0 8 0 0 0</pose><diffuse>0.85 0.85 0.85 1</diffuse><specular>0.1 0.1 0.1 1</specular><direction>-0.5 0.3 -1</direction><cast_shadows>false</cast_shadows></light>
  <model name="ground"><static>true</static><link name="ground_link">
   <collision name="ground"><geometry><box><size>30 30 0.1</size></box></geometry><pose>0 0 -0.05 0 0 0</pose><surface><friction><ode><mu>0.9</mu><mu2>0.7</mu2></ode></friction></surface></collision>
   <visual name="ground"><pose>0 0 -0.05 0 0 0</pose><geometry><box><size>30 30 0.1</size></box></geometry><material><ambient>0.55 0.57 0.58 1</ambient><diffuse>0.55 0.57 0.58 1</diffuse></material></visual>
  </link></model>
  <model name="step_15mm"><static>true</static><pose>1.0 0 0.0075 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.12 0.9 0.015</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 0.9 0.015</size></box></geometry><material><diffuse>0.6 0.3 0.1 1</diffuse></material></visual></link></model>
  <model name="ramp"><static>true</static><pose>2 0 0.085 0 -0.2 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.8 0.9 0.025</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.8 0.9 0.025</size></box></geometry><material><diffuse>0.2 0.4 0.6 1</diffuse></material></visual></link></model>
  <model name="lidar_target"><static>true</static><pose>3 1 0.4 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.4 0.4 0.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.4 0.4 0.8</size></box></geometry><material><diffuse>0.8 0.2 0.2 1</diffuse></material></visual></link></model>
  <model name="wall_front"><static>true</static><pose>3.8 0 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.1 5 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 5 1</size></box></geometry><material><diffuse>0.45 0.55 0.65 1</diffuse></material></visual></link></model>
  <model name="wall_left"><static>true</static><pose>0.5 2.5 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>6.6 0.1 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>6.6 0.1 1</size></box></geometry><material><diffuse>0.45 0.55 0.65 1</diffuse></material></visual></link></model>
  <model name="wall_right"><static>true</static><pose>0.5 -2.5 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>6.6 0.1 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>6.6 0.1 1</size></box></geometry><material><diffuse>0.45 0.55 0.65 1</diffuse></material></visual></link></model>
  <model name="wall_rear"><static>true</static><pose>-2.8 0 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.1 5 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 5 1</size></box></geometry><material><diffuse>0.45 0.55 0.65 1</diffuse></material></visual></link></model>
 </world>
</sdf>
