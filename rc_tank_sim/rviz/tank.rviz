Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: odom
    Frame Rate: 15
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
    - Class: rviz_default_plugins/RobotModel
      Name: Tank
      Enabled: true
      Visual Enabled: true
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
    - Class: rviz_default_plugins/LaserScan
      Name: Lidar returns
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 2
      Queue Size: 3
      Style: Points
      Size (Pixels): 3
      Size (m): 0.025
      Decay Time: 0
      Color Transformer: FlatColor
      Color: 0; 255; 255
      Alpha: 1
    - Class: rviz_default_plugins/Marker
      Name: Lidar measured rays
      Enabled: true
      Marker Topic:
        Value: /tank/lidar_rays
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Physical tracks - batched
      Enabled: true
      Marker Topic:
        Value: /tank/track_markers
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Lights - batched
      Enabled: true
      Marker Topic:
        Value: /tank/light_markers
        Depth: 1
    - Class: rviz_default_plugins/Image
      Name: Left stereo - optional
      Enabled: false
      Topic:
        Value: /camera/left/image_raw
        Reliability Policy: Best Effort
        Depth: 1
    - Class: rviz_default_plugins/Image
      Name: Right stereo - optional
      Enabled: false
      Topic:
        Value: /camera/right/image_raw
        Reliability Policy: Best Effort
        Depth: 1
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4.5
      Pitch: 0.7
      Yaw: 0.75
      Focal Point: {X: 0.3, Y: 0, Z: 0.1}
Window Geometry:
  Width: 1100
  Height: 740
